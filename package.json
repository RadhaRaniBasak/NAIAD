  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --import tsx --test \"src/**/__tests__/*.{ts,tsx}\" \"test/integration/*.ts\"",
